# Public Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key

# Server-only Supabase access
SUPABASE_SECRET_KEY=replace-in-deployment-secret-store

# Sensitive identity protection
IDENTITY_ENCRYPTION_KEY_B64=replace-with-32-byte-base64-key
IDENTITY_ENCRYPTION_KEY_VERSION=production-v1
IDENTITY_LOOKUP_PEPPER=replace-in-deployment-secret-store

# Deployment control. Keep synthetic until external gates are satisfied.
DEPLOYMENT_STAGE=synthetic
PUBLIC_BASE_URL=https://insure-me.example

# Synthetic privacy controls. Synthetic values fail closed in pilot/production.
PRIVACY_IDENTITY_ADAPTER_ID=synthetic-privacy-identity-v1
PRIVACY_IDENTITY_POLICY_VERSION=synthetic-policy-v1
PRIVACY_EXPORT_POLICY_VERSION=synthetic-privacy-export-v1
PRIVACY_RIGHTS_EXECUTION_POLICY_VERSION=synthetic-privacy-rights-v1
PRIVACY_PROPAGATION_ADAPTER_ID=synthetic-privacy-propagation-v1
PRIVACY_PROPAGATION_POLICY_VERSION=synthetic-privacy-propagation-policy-v1

# Evidence references only. Do not place legal documents or secrets here.
DEPLOYMENT_AUTHORITY_REF=BLOCKED-Q-001
LEGAL_NOTICE_APPROVAL_REF=BLOCKED-Q-006
DATA_RETENTION_APPROVAL_REF=BLOCKED-Q-007
FCRA_ROLE_APPROVAL_REF=BLOCKED-Q-005
PRIVACY_ROLE_APPROVAL_REF=BLOCKED-Q-008
SECURITY_REVIEW_REF=BLOCKED-SECURITY-REVIEW
INCIDENT_RESPONSE_OWNER=security-owner@example.com

# These may become true only after non-synthetic integrations are verified.
LIVE_PROVIDER_BINDINGS_VERIFIED=false
LIVE_CARRIER_PROGRAMS_VERIFIED=false
