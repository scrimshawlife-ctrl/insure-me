{
  "name": "insure-me",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "scenario:run": "vitest run tests/contract/canonical-scenario-command.test.ts --reporter=verbose",
    "test:load": "node scripts/performance/load-test.mjs",
    "test:restore-drill": "node scripts/recovery/restore-drill.mjs",
    "test:provider-outage-drill": "vitest run tests/contract/provider-outage-drill-command.test.ts --reporter=verbose",
    "test:provider-credential-rotation-drill": "vitest run tests/contract/provider-credential-rotation-drill-command.test.ts --reporter=verbose",
    "test:incident-response-tabletop": "vitest run tests/contract/incident-response-tabletop-command.test.ts --reporter=verbose",
    "test:privacy-rights-rehearsal": "PRIVACY_REHEARSAL_ENABLED=1 vitest run tests/contract/privacy-rights-rehearsal-command.test.ts --reporter=verbose",
    "test:adverse-action-rehearsal": "ADVERSE_ACTION_REHEARSAL_ENABLED=1 vitest run tests/contract/adverse-action-rehearsal-command.test.ts --reporter=verbose",
    "db:start": "supabase start",
    "db:stop": "supabase stop --no-backup",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --local --fail-on error",
    "db:types": "supabase gen types typescript --local --schema public > src/infrastructure/supabase/database.types.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm security:baseline",
    "security-assessment:readiness": "node scripts/security/security-assessment-readiness.mjs",
    "security:secrets": "node scripts/security/repository-baseline-scanner.mjs secret",
    "security:sast": "node scripts/security/repository-baseline-scanner.mjs sast",
    "security:dependencies": "node scripts/security/pnpm-audit-baseline.mjs",
    "security:baseline": "node scripts/security/repository-baseline-scanner.mjs secret && node scripts/security/repository-baseline-scanner.mjs sast && node scripts/security/pnpm-audit-baseline.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "22.12.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "supabase": "2.115.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
